---
import { site } from '../../data/site';
import Container from './Container.astro';
---

<section id="contact" class="bg-d3-lime py-20 text-d3-obsidian md:py-28">
  <Container class="flex flex-col items-center gap-8 text-center">
    <h2 class="font-d3-display text-3xl font-semibold tracking-tight md:text-5xl">
      Hai să vorbim despre proiectul tău
    </h2>
    <p class="max-w-xl text-base leading-relaxed text-d3-obsidian/70 md:text-lg">
      {site.coverageLine}
    </p>

    <div class="flex flex-col items-center gap-3">
      <a href={site.phoneHref} class="font-d3-display text-2xl font-semibold md:text-3xl">
        {site.phone}
      </a>
      <a href={site.emailHref} class="text-lg font-medium underline decoration-2 underline-offset-4 md:text-xl">
        {site.email}
      </a>
    </div>

    <p class="text-sm text-d3-obsidian/70">{site.workingHours}</p>
  </Container>
</section>
