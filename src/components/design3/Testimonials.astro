---
import { getCollection } from 'astro:content';
import Container from './Container.astro';
import TestimonialSpotlight from './TestimonialSpotlight.astro';

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
---

{testimonials.length > 0 && (
  <section id="testimoniale" class="py-20 md:py-28">
    <Container>
      {testimonials.length === 1 ? (
        <TestimonialSpotlight testimonial={testimonials[0]} />
      ) : (
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
          {testimonials.map((testimonial) => (
            <TestimonialSpotlight testimonial={testimonial} compact />
          ))}
        </div>
      )}
    </Container>
  </section>
)}
