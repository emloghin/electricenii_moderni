---
import MicroLabel from './MicroLabel.astro';
import Button from './Button.astro';
import SpecStrip from './SpecStrip.astro';
---

<section class="relative overflow-hidden pt-20 pb-24 md:pt-28 md:pb-32">
  <div class="d3-glow pointer-events-none absolute inset-0"></div>

  <div class="relative mx-auto flex w-full max-w-6xl flex-col items-center px-5 text-center sm:px-8">
    <MicroLabel tone="lime" class="mb-6">Electricieni Moderni</MicroLabel>

    <h1 class="max-w-4xl font-d3-display text-4xl font-semibold leading-[1.0] tracking-tight text-d3-chalk md:text-6xl lg:text-7xl">
      Instalații electrice case noi, integrate smart cu Home Assistant
    </h1>

    <p class="mt-8 max-w-2xl text-base leading-relaxed text-d3-mist md:text-lg">
      Proiectăm și executăm instalații electrice conforme normativului I7, apoi
      le integrăm cu Home Assistant — control local, fără dependență de cloud.
      Aceeași abordare pe care fondatorul a aplicat-o în propria casă pasivă.
    </p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      <Button href="#contact" variant="primary">Cere ofertă</Button>
      <Button href="#proiecte" variant="ghost">Vezi proiectul nostru</Button>
    </div>

    <div class="mt-16 w-full">
      <SpecStrip />
    </div>
  </div>
</section>
