---
import Tile from './Tile.astro';
import MicroLabel from './MicroLabel.astro';
import { render } from 'astro:content';

interface Props {
  service: any;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;
const { title, category, summary } = service.data;
const tone = category === 'smart' ? 'cyan' : 'lime';
const { Content } = featured ? await render(service) : { Content: null };
---

<Tile hover class={featured ? 'flex h-full flex-col justify-between md:col-span-2 lg:col-span-2 lg:row-span-2' : 'flex h-full flex-col justify-between'}>
  <div>
    <MicroLabel tone={tone}>{category === 'smart' ? 'Smart' : 'Clasic'}</MicroLabel>
    <h3 class={`mt-4 font-d3-display font-semibold text-d3-chalk tracking-tight ${featured ? 'text-2xl md:text-3xl' : 'text-xl'}`}>
      {title}
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-d3-mist md:text-base">{summary}</p>
    {featured && Content && (
      <div class="prose-d3 mt-5 space-y-3 text-sm leading-relaxed text-d3-mist md:text-base">
        <Content />
      </div>
    )}
  </div>
</Tile>
