---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import VideoEmbed from './shared/VideoEmbed.astro';

interface Props {
  title: string;
  location: string;
  year: number;
  summary: string;
  tags: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  video?: string;
  videoTitle?: string;
}

const { title, location, year, summary, tags, image, imageAlt, video, videoTitle } = Astro.props;
const videoIsEmbed = video?.startsWith('http');
---

<article class="flex h-full flex-col border border-hairline bg-surface transition-all duration-150 hover:-translate-y-0.5 hover:border-blueprint-600">
  {
    image ? (
      <Image src={image} alt={imageAlt ?? title} class="h-48 w-full object-cover" width={800} height={500} />
    ) : (
      <div class="bg-blueprint-grid flex h-48 w-full items-center justify-center bg-blueprint-950">
        <p class="px-6 text-center font-display text-lg font-semibold text-surface">{title}</p>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6 md:p-8">
    <p class="font-mono text-xs uppercase tracking-widest text-blueprint-600">{year} · {location}</p>
    <h3 class="mt-3 font-display text-xl font-semibold text-ink-900">{title}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600 md:text-base">{summary}</p>
    {
      video && (
        <div class="mt-5">
          <VideoEmbed
            embedUrl={videoIsEmbed ? video : undefined}
            src={videoIsEmbed ? undefined : video}
            title={videoTitle ?? title}
          />
        </div>
      )
    }
    {
      tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="border border-hairline px-2 py-1 font-mono text-[10px] uppercase tracking-widest text-ink-600">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
