---
// Iconografie inline, linie subțire (plan D-012). Fiecare glif e desenat cu
// primitive geometrice simple; nicio pictogramă nu rămâne goală datorită
// glifului neutru de rezervă.
interface Props {
  name?: string;
  class?: string;
}

const { name = 'default', class: className = 'h-6 w-6' } = Astro.props;

const common = {
  width: '24',
  height: '24',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.5',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---

{name === 'panel' && (
  <svg {...common} class={className}>
    <rect x="4" y="3" width="16" height="18" rx="1" />
    <line x1="8" y1="7" x2="16" y2="7" />
    <line x1="8" y1="11" x2="16" y2="11" />
    <line x1="8" y1="15" x2="16" y2="15" />
  </svg>
)}
{name === 'smart-home' && (
  <svg {...common} class={className}>
    <polyline points="4,11 12,4 20,11" />
    <rect x="6" y="11" width="12" height="9" />
    <circle cx="12" cy="15.5" r="1.5" />
  </svg>
)}
{name === 'install' && (
  <svg {...common} class={className}>
    <circle cx="12" cy="12" r="8.5" />
    <line x1="12" y1="7.5" x2="12" y2="12" />
    <line x1="12" y1="12" x2="15" y2="14.5" />
  </svg>
)}
{name === 'automation' && (
  <svg {...common} class={className}>
    <circle cx="12" cy="12" r="3" />
    <line x1="12" y1="2.5" x2="12" y2="6" />
    <line x1="12" y1="18" x2="12" y2="21.5" />
    <line x1="2.5" y1="12" x2="6" y2="12" />
    <line x1="18" y1="12" x2="21.5" y2="12" />
  </svg>
)}
{name === 'location' && (
  <svg {...common} class={className}>
    <circle cx="12" cy="10" r="3" />
    <path d="M12 21c-4-4.5-7-8-7-11a7 7 0 0 1 14 0c0 3-3 6.5-7 11Z" />
  </svg>
)}
{!['panel', 'smart-home', 'install', 'automation', 'location'].includes(name) && (
  <svg {...common} class={className}>
    <circle cx="12" cy="12" r="8.5" />
    <line x1="8.5" y1="12" x2="15.5" y2="12" />
  </svg>
)}
