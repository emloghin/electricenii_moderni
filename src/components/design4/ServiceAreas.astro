---
import { site } from '../../data/site';
import Section from './Section.astro';
import SectionLabel from './SectionLabel.astro';
---

<Section id="zone" band="snow">
  <SectionLabel slot="label" eyebrow="Zone deservite" title="Unde lucrăm" />
  <div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 text-lg text-d4-ink md:text-xl">
      {site.counties.map((county, i) => (
        <>
          {i > 0 && <span class="text-d4-mist">/</span>}
          <span>{county}</span>
        </>
      ))}
    </div>
    <p class="mt-6 max-w-xl text-d4-slate">{site.coverageLine}</p>
  </div>
</Section>
