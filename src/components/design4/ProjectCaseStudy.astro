---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Icon from './Icon.astro';
import VideoEmbed from '../shared/VideoEmbed.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, location, year, summary, image, imageAlt, tags, video, videoTitle } = project.data;
const { Content } = await render(project);
const videoIsEmbed = video?.startsWith('http');
---

<div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14">
  <div class="d4-tint rounded-[--radius-d4-plate] bg-d4-mist p-6 md:p-10">
    {video ? (
      <VideoEmbed
        embedUrl={videoIsEmbed ? video : undefined}
        src={!videoIsEmbed ? video : undefined}
        title={videoTitle ?? title}
        class="rounded-[--radius-d4-btn]"
      />
    ) : image ? (
      <Image
        src={image}
        alt={imageAlt ?? title}
        class="w-full rounded-[--radius-d4-btn] opacity-90 mix-blend-multiply"
      />
    ) : (
      <div class="flex aspect-[4/3] w-full items-center justify-center rounded-[--radius-d4-btn]">
        <Icon name="location" class="h-10 w-10 text-d4-sage" />
      </div>
    )}
  </div>

  <div>
    <h3 class="font-d4-display text-2xl font-light md:text-3xl">{title}</h3>
    <p class="mt-2 flex items-center gap-2 text-sm text-d4-slate">
      <Icon name="location" class="h-4 w-4 text-d4-sage" />
      {location} · {year}
    </p>
    <p class="mt-6 text-base text-d4-slate md:text-lg">{summary}</p>

    <div class="d4-rule mt-8 max-w-none pt-8 text-d4-slate [&_p]:mb-4 [&_strong]:font-medium [&_strong]:text-d4-ink">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs uppercase tracking-[0.1em] text-d4-sage">
        {tags.map((tag, i) => (
          <>
            {i > 0 && <span class="text-d4-mist">·</span>}
            <span>{tag}</span>
          </>
        ))}
      </div>
    )}
  </div>
</div>
