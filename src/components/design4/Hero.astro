---
import { site } from '../../data/site';
import Container from './Container.astro';
import Button from './Button.astro';

const capabilities = ['Normativ I7', 'Home Assistant', ...site.counties];
---

<section class="d4-tint bg-d4-snow py-28 md:py-40">
  <Container>
    <div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-12">
      <div class="md:col-span-8 md:col-start-1 lg:col-span-9">
        <h1 class="font-d4-display text-4xl font-light tracking-tight text-d4-ink md:text-6xl lg:text-7xl">
          Instalații electrice și smart home, gândite să dureze.
        </h1>
        <p class="mt-6 max-w-xl text-base text-d4-slate md:text-lg">
          {site.tagline}
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <Button href={site.emailHref} variant="solid">Cere ofertă</Button>
          <Button href="#servicii" variant="ghost">Vezi serviciile</Button>
        </div>

        <div class="mt-14 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-d4-slate">
          {capabilities.map((item, i) => (
            <>
              {i > 0 && <span class="text-d4-mist">·</span>}
              <span>{item}</span>
            </>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
