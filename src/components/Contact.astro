---
import { site } from '../data/site';
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
---

<section id="contact" class="bg-surface py-16 md:py-24 lg:py-28">
  <Container>
    <SectionHeading
      index="06"
      eyebrow="Hai să discutăm"
      title="Contact"
      subtitle="Sunați, scrieți sau trimiteți-ne un e-mail cu detaliile proiectului — răspundem în timpul programului de lucru."
    />

    <div class="grid gap-6 md:grid-cols-2 md:gap-8">
      <a
        href={site.phoneHref}
        class="flex min-h-[44px] flex-col justify-center border border-hairline p-6 transition-all duration-150 hover:-translate-y-0.5 hover:border-blueprint-600 md:p-8"
      >
        <span class="font-mono text-xs uppercase tracking-widest text-blueprint-600">Telefon</span>
        <span class="mt-2 font-display text-2xl font-semibold text-ink-900">{site.phone}</span>
      </a>

      <a
        href={site.emailHref}
        class="flex min-h-[44px] flex-col justify-center border border-hairline p-6 transition-all duration-150 hover:-translate-y-0.5 hover:border-blueprint-600 md:p-8"
      >
        <span class="font-mono text-xs uppercase tracking-widest text-blueprint-600">E-mail</span>
        <span class="mt-2 font-display text-2xl font-semibold text-ink-900 break-all">{site.email}</span>
      </a>
    </div>

    <div class="mt-8 flex flex-col gap-6 border border-hairline p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
      <div class="text-sm leading-relaxed text-ink-600">
        <p><span class="font-mono uppercase tracking-widest text-blueprint-600">Program:</span> {site.workingHours}</p>
        <p class="mt-1">{site.coverageLine}</p>
      </div>
      <Button href={site.emailHref} variant="primary">Cere ofertă</Button>
    </div>
  </Container>
</section>
