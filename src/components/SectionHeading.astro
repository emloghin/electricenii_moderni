---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  tone?: 'light' | 'dark';
}

const { index, eyebrow, title, subtitle, tone = 'light' } = Astro.props;
const isDark = tone === 'dark';
---

<div class="mb-10 md:mb-14">
  <span class="font-mono text-sm tracking-widest text-accent-500">{index}</span>
  <p
    class={`mt-2 font-mono text-xs uppercase tracking-[0.2em] ${isDark ? 'text-blueprint-100' : 'text-blueprint-600'}`}
  >
    {eyebrow}
  </p>
  <h2
    class={`mt-3 font-display text-3xl font-semibold tracking-tight md:text-4xl lg:text-5xl ${isDark ? 'text-surface' : 'text-ink-900'}`}
  >
    {title}
  </h2>
  <span class="mt-4 block h-px w-12 bg-accent-500"></span>
  {
    subtitle && (
      <p class={`mt-4 max-w-2xl text-base leading-relaxed md:text-lg ${isDark ? 'text-blueprint-100' : 'text-ink-600'}`}>
        {subtitle}
      </p>
    )
  }
</div>
