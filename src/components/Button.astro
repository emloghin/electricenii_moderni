---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  tone?: 'light' | 'dark';
  class?: string;
}

const { href, variant = 'primary', tone = 'light', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-none px-6 py-3 font-mono text-xs uppercase tracking-widest transition-all duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500';

const variants = {
  primary: 'bg-accent-500 text-blueprint-950 hover:-translate-y-0.5 hover:bg-accent-500/90',
  secondary:
    tone === 'dark'
      ? 'border border-white/30 text-surface hover:-translate-y-0.5 hover:border-white'
      : 'border border-blueprint-600/40 text-blueprint-600 hover:-translate-y-0.5 hover:border-blueprint-600',
};
---

<a href={href} class={`${base} ${variants[variant]} ${className}`}>
  <slot />
</a>
