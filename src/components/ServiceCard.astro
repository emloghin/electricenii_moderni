---
interface Props {
  title: string;
  category: 'clasic' | 'smart';
  summary: string;
  index: number;
}

const { title, category, summary, index } = Astro.props;
const isSmart = category === 'smart';
---

<article
  class="group flex h-full flex-col border border-hairline bg-surface p-6 transition-all duration-150 hover:-translate-y-0.5 hover:border-blueprint-600 md:p-8"
>
  <div class="flex items-start justify-between">
    <span class="font-mono text-xs text-blueprint-600/70">{String(index).padStart(2, '0')}</span>
    <span
      class={`font-mono text-[10px] uppercase tracking-widest px-2 py-1 border ${
        isSmart ? 'border-accent-500 text-accent-500' : 'border-blueprint-600 text-blueprint-600'
      }`}
    >
      {isSmart ? 'Smart' : 'Clasic'}
    </span>
  </div>
  <h3 class="mt-5 font-display text-xl font-semibold text-ink-900">{title}</h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600 md:text-base">{summary}</p>
</article>
