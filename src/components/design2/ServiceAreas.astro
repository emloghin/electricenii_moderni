---
import { site } from '../../data/site';
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import Pill from './Pill.astro';
import Button from './Button.astro';
---

<section id="zone" class="bg-d2-cream py-20 md:py-28 lg:py-32">
  <Container>
    <div class="d2-noise relative overflow-hidden rounded-[var(--radius-d2-panel)] bg-d2-forest px-6 py-12 md:px-12 md:py-16">
      <SectionHeading
        eyebrow="Zone deservite"
        title="Venim la tine, oriunde te-ai afla în țară"
        tone="onForest"
      />
      <div class="flex flex-wrap gap-3">
        {site.counties.map((county) => (
          <Pill label={county} tone="sand" />
        ))}
      </div>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-d2-cream/85">
        {site.coverageLine}
      </p>
      <div class="mt-8">
        <Button href="#contact" variant="secondary" tone="onForest">Hai să vorbim</Button>
      </div>
    </div>
  </Container>
</section>
