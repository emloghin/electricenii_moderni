---
import { Image } from 'astro:assets';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { title, location, year, summary, image, imageAlt } = entry.data;
---

<article class="flex gap-4 rounded-[var(--radius-d2-card)] bg-d2-cream p-4 shadow-[var(--shadow-d2-soft)] transition-all duration-150 hover:-translate-y-0.5 hover:shadow-[var(--shadow-d2-lift)]">
  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-[1rem]" style="width:5rem;height:5rem;">
    {
      image ? (
        <div class="relative" style="width:100%;height:100%;">
          <Image src={image} alt={imageAlt ?? title} class="h-full w-full object-cover" width={200} height={200} />
          <div class="pointer-events-none absolute inset-0 h-full w-full bg-d2-clay mix-blend-color" />
          <div class="pointer-events-none absolute inset-0 h-full w-full bg-d2-cream/10" />
        </div>
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-d2-sand to-d2-sand-deep">
          <p class="font-d2-display text-lg font-semibold text-d2-ink">{title.charAt(0)}</p>
        </div>
      )
    }
  </div>
  <div class="min-w-0">
    <p class="text-sm font-semibold text-d2-clay">{year} · {location}</p>
    <h4 class="mt-1 font-d2-display text-lg font-semibold text-d2-ink">{title}</h4>
    <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-d2-muted">
      {summary}
    </p>
  </div>
</article>
