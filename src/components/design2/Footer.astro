---
import { site } from '../../data/site';
import Container from './Container.astro';

const year = new Date().getFullYear();
---

<footer class="rounded-t-[var(--radius-d2-panel)] bg-d2-forest-deep py-12 text-d2-cream md:py-16">
  <Container>
    <div class="flex flex-col gap-8 md:grid md:grid-cols-3">
      <div>
        <p class="font-d2-display text-xl font-semibold">{site.name}</p>
        <p class="mt-3 text-sm leading-relaxed text-d2-cream/80">
          Instalații electrice conforme normativului I7 și integrare smart home
          cu Home Assistant.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold text-d2-cream/80">Contact</p>
        <p class="mt-3 text-sm">
          <a href={site.phoneHref} class="hover:underline">{site.phone}</a>
        </p>
        <p class="mt-1 text-sm">
          <a href={site.emailHref} class="hover:underline">{site.email}</a>
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold text-d2-cream/80">Zone deservite</p>
        <p class="mt-3 text-sm">{site.counties.join(', ')} și restul țării.</p>
      </div>
    </div>
    <p class="mt-10 text-sm text-d2-cream/60">© {year} {site.name}. Toate drepturile rezervate.</p>
  </Container>
</footer>
