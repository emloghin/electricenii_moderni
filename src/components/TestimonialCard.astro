---
interface Props {
  quote: string;
  author: string;
  location: string;
  role?: string;
  rating?: number;
}

const { quote, author, location, role, rating } = Astro.props;
---

<figure class="flex h-full flex-col border border-hairline bg-surface p-6 md:p-8">
  <span class="font-display text-4xl leading-none text-accent-500">"</span>
  <blockquote class="mt-2 flex-1 text-base leading-relaxed text-ink-600 md:text-lg">{quote}</blockquote>
  {
    rating && (
      <div class="mt-4 flex gap-1 text-accent-500" aria-hidden="true">
        {Array.from({ length: rating }).map(() => (
          <span>★</span>
        ))}
      </div>
    )
  }
  <figcaption class="mt-4 border-t border-hairline pt-4">
    <p class="font-display text-sm font-semibold text-ink-900">{author}</p>
    <p class="font-mono text-xs uppercase tracking-widest text-blueprint-600">
      {role ? `${role} · ` : ''}{location}
    </p>
  </figcaption>
</figure>
