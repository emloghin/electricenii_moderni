---
import Design3Layout from '../layouts/Design3Layout.astro';
import Header from '../components/design3/Header.astro';
import Hero from '../components/design3/Hero.astro';
import Services from '../components/design3/Services.astro';
import About from '../components/design3/About.astro';
import Projects from '../components/design3/Projects.astro';
import Testimonials from '../components/design3/Testimonials.astro';
import ServiceAreas from '../components/design3/ServiceAreas.astro';
import Contact from '../components/design3/Contact.astro';
import Footer from '../components/design3/Footer.astro';
---

<Design3Layout
  title="Curent Premium — Electricieni Moderni | Instalații I7 & Home Assistant"
  description="Instalații electrice conforme normativului I7 și integrare smart home cu Home Assistant, pentru Neamț, Suceava, Iași, Botoșani și toată țara."
>
  <Header />
  <main>
    <Hero />
    <Services />
    <About />
    <Projects />
    <Testimonials />
    <ServiceAreas />
    <Contact />
  </main>
  <Footer />
</Design3Layout>
